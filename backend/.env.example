# Copy to .env and adjust
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CREDIT_EXTENSION_DAYS=10
NOTIF_EVERY_HOURS=2
PAYMENT_NOTIF_DAILY_HOUR=9

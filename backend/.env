# Copy to .env and adjust
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app_local
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CREDIT_EXTENSION_DAYS=10
NOTIF_EVERY_HOURS=2
# Daily hour removed in codebase; retained here for historical reference
# PAYMENT_NOTIF_DAILY_HOUR=9

# Test-only: override notification cadence to minute-level
# NOTIF_TEST_MINUTES=1

# service account file path
SERVICE_ACCOUNT_FILE=../payments-5c6bd-firebase-adminsdk-fbsvc-017e8c829a.json
PROJECT_ID=payments-5c6bd

# Authentication rate limits
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_AUTH_ME=60/minute
RATE_LIMIT_PUSH_TOKEN=10/minute

# Payment rate limits
RATE_LIMIT_PAYMENT_SUBMIT=10/hour
RATE_LIMIT_PAYMENT_BULK=10/hour
RATE_LIMIT_PAYMENT_APPROVAL=20/minute
RATE_LIMIT_PAYMENT_APPROVE=20/minute
RATE_LIMIT_PAYMENT_DECLINE=20/minute

# Admin operation rate limits
RATE_LIMIT_USER_CREATION=10/hour
RATE_LIMIT_USER_DELETE=10/hour
RATE_LIMIT_SETTINGS_UPDATE=5/hour
RATE_LIMIT_RECONCILE=10/hour
RATE_LIMIT_NOTIFICATION_SCAN=10/hour

# Data retrieval rate limits
RATE_LIMIT_HEALTH=120/minute
RATE_LIMIT_DATA_READ=60/minute
RATE_LIMIT_DATA_READ_HIGH=120/minute

# File upload rate limits
RATE_LIMIT_UPLOAD_MASTER=10/hour
RATE_LIMIT_UPLOAD_TRANSACTIONS=10/hour

# Company management rate limits
RATE_LIMIT_PROMISE_UPDATE=30/minute
RATE_LIMIT_CREDIT_UPDATE=30/hour

# General fallback rate limits
RATE_LIMIT_GENERAL=100/minute

# Dedicated test DB URL (so pytest doesn't reuse production DB). Create the DB first (see README instructions)
TEST_DB_URL=postgresql+psycopg://app:app@db:5432/app_test

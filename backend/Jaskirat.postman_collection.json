            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (!pm.collectionVariables.get('idempotency_key')) { pm.collectionVariables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}')); }"
              ]

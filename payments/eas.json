{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8000",
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_DEBUG_MODE": "true",
        "EXPO_PUBLIC_PROJECT_ID": "payments-5c6bd",
        "EXPO_PUBLIC_APP_VERSION": "1.1.0-dev"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://moneymanagementapp-production.up.railway.app",
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_DEBUG_MODE": "true",
        "EXPO_PUBLIC_PROJECT_ID": "payments-5c6bd",
        "EXPO_PUBLIC_APP_VERSION": "1.1.0-rc"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://moneymanagementapp-production.up.railway.app",
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_DEBUG_MODE": "false",
        "EXPO_PUBLIC_PROJECT_ID": "payments-5c6bd",
        "EXPO_PUBLIC_APP_VERSION": "1.1.0"
      },
      "channel": "production"
    },
    "prod-arm64": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://moneymanagementapp-production.up.railway.app",
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_DEBUG_MODE": "false",
        "EXPO_PUBLIC_PROJECT_ID": "payments-5c6bd",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}

# Jaskirat Textiles - Frontend Environment Variables

# Backend API Configuration
# EXPO_PUBLIC_API_BASE_URL=https://moneymanagementapp-production.up.railway.app
# EXPO_PUBLIC_API_BASE_URL=http://10.41.225.62:8000
EXPO_PUBLIC_API_BASE_URL=http://172.60.2.250:8000

# Alternative URLs for different environments
# For network access (when testing on different devices):
# EXPO_PUBLIC_API_BASE_URL=http://10.72.122.62:8000/api

# For production deployment:
# EXPO_PUBLIC_API_BASE_URL=https://your-production-domain.com/api

# For different IP addresses (update as needed):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api

# App Configuration
EXPO_PUBLIC_APP_NAME=Jaskirat Textiles
EXPO_PUBLIC_APP_VERSION=1.0.0

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=true

# Feature Flags (for enabling/disabling features)
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCATION_TRACKING=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false

# API Timeouts (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_RETRY_ATTEMPTS=3

# Environment Type
EXPO_PUBLIC_ENVIRONMENT=development

# EXPO_PUBLIC_APP_URI=https://moneymanagementapp-production.up.railway.app
# EXPO_PUBLIC_APP_URI=http://10.41.225.62:8000
EXPO_PUBLIC_API_BASE_URL=http://172.60.2.250:8000

EXPO_PUBLIC_PROJECT_ID=payments-5c6bd
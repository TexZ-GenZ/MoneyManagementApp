{
  "expo": {
    "name": "Paymt",
    "owner": "greenpig69",
    "slug": "payments",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "scheme": "payments",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "jsEngine": "hermes",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.skywalker421.payments",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "color": "#A0E01B",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": [
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "resourceConfigurations": [
              "en"
            ],
            "packagingOptions": {
              "exclude": [
                "META-INF/LICENSE*",
                "META-INF/NOTICE*",
                "META-INF/*.kotlin_module"
              ]
            },
            "extraProguardRules": "-dontnote kotlin.internal.jdk8.JDK8PlatformImplementations\n-dontnote kotlin.internal.jdk7.JDK7PlatformImplementations\n-keep class com.facebook.hermes.** { *; }\n-keep class expo.modules.notifications.** { *; }\n-keep class com.google.firebase.messaging.** { *; }\n"
          }
        }
      ],
      [
        "./plugins/fcm-manifest-fix.js",
        {
          "channelId": "default",
          "color": "@color/notification_icon_color"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85091841-3805-4902-9e31-08bafa2771a9"
      }
    },
    "runtimeVersion": "1.1",
    "updates": {
      "url": "https://u.expo.dev/85091841-3805-4902-9e31-08bafa2771a9",
      "checkOnLaunch": "ALWAYS",
      "fallbackToCacheTimeout": 0
    }
  }
}
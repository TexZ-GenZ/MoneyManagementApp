# Jaskirat Textiles - Frontend Environment Variables Example
# Copy this file to .env and update the values as needed

# Backend API Configuration
EXPO_PUBLIC_API_BASE_URL=http://your-backend-ip:8000/api

# Common IP configurations:
# Local Docker: http://10.184.177.62:8000/api
# Localhost: http://localhost:8000/api
# Local Network: http://192.168.1.100:8000/api
# Production: https://your-domain.com/api

# App Configuration
EXPO_PUBLIC_APP_NAME=Jaskirat Textiles
EXPO_PUBLIC_APP_VERSION=1.0.0

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=true

# Feature Flags
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCATION_TRACKING=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false

# API Configuration
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_RETRY_ATTEMPTS=3

# Environment Type (development, staging, production)
EXPO_PUBLIC_ENVIRONMENT=development
